pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- each check compiles its snippet on its own, so syntax PICO-8 lacks fails one check and not the cart
fails=0
function ck(name, src, want)
 local f, e = load("return "..src)
 if not f then f, e = load(src) end
 if not f then printh("SYNTAX "..name..": "..tostr(e)) fails+=1 return end
 local ok, got = pcall(f)
 if not ok then printh("ERROR  "..name..": "..tostr(got)) fails+=1 return end
 if tostr(got) != tostr(want) then printh("WRONG  "..name..": got "..tostr(got).." want "..tostr(want)) fails+=1 end
end
ck("rrect", "(function() cls() rrect(0,0,8,8,2,7) return pget(0,4)..pget(2,0)..pget(0,0) end)()", "770")
ck("rrectfill", "(function() cls() rrectfill(0,0,8,8,2,7) return pget(4,4)..pget(0,0) end)()", "70")
